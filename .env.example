# Copy to .env and fill in. Never commit the real .env.
# Local development needs only the first block plus ANTHROPIC_API_KEY.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
# Production: your domain plus localhost (used by the container health check),
# e.g. DJANGO_ALLOWED_HOSTS=3-12-45-67.sslip.io,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://<your domain>, e.g. https://3-12-45-67.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=
# Local development defaults to SQLite when unset; docker-compose sets it for you.
DATABASE_URL=

# --- Limits ---
MAX_UPLOAD_SIZE_MB=50
THROTTLE_PREVIEW=60/hour
THROTTLE_UPLOAD=30/hour

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# --- Docker deployment only (docker-compose.yml) ---
# Domain Caddy serves and gets an HTTPS certificate for, e.g. 3-12-45-67.sslip.io.
# Use http://localhost to try the stack locally without HTTPS.
SITE_ADDRESS=http://localhost
POSTGRES_DB=rhombus
POSTGRES_USER=rhombus
POSTGRES_PASSWORD=change-me
