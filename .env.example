# Copy to .env and fill in. Never commit the real .env.
# Local development needs only the first block plus ANTHROPIC_API_KEY.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
# Production: your domain plus localhost (used by the container health check),
# e.g. DJANGO_ALLOWED_HOSTS=3-12-45-67.sslip.io,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://<your domain>, e.g. https://3-12-45-67.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=
# Local development defaults to SQLite when unset; docker-compose sets it for you.
DATABASE_URL=

# --- Limits ---
MAX_UPLOAD_SIZE_MB=200
# Excel files are parsed in one go (CSV in batches), so they have a lower limit.
MAX_EXCEL_UPLOAD_SIZE_MB=50
THROTTLE_PREVIEW=60/hour
THROTTLE_UPLOAD=30/hour

# --- LLM ---
ANTHROPIC_API_KEY=
# Turns descriptions into regexes (one call per preview).
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Labels values for "Classify" (one call per 100 distinct values), so a small, fast model.
LLM_CLASSIFY_MODEL=claude-haiku-5-5
LLM_CLASSIFY_EFFORT=low
MAX_CLASSIFY_VALUES=1000
THROTTLE_CLASSIFY=20/hour

# --- Docker deployment only (docker-compose.yml) ---
# Domain Caddy serves and gets an HTTPS certificate for, e.g. 3-12-45-67.sslip.io.
# Use http://localhost to try the stack locally without HTTPS.
SITE_ADDRESS=http://localhost
POSTGRES_DB=rhombus
POSTGRES_USER=rhombus
POSTGRES_PASSWORD=change-me
